<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="apple-mobile-web-app-title" content="日本語 Study">
<title>日本語 Study</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{--bg:#000;--bg2:#0d0d0d;--bg3:#1a1a1a;--border:#222;--border2:#333;--border3:#444;--text:#fff;--text2:#999;--text3:#555;--accent:#e8c84a;--red:#e85454;--green:#4ac87a;--radius:12px;--radius-sm:8px;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;overflow-x:hidden;font-size:15px;}
.jp{font-family:'Noto Sans JP',sans-serif;}
button{cursor:pointer;border:none;background:none;color:inherit;font-family:inherit;font-size:inherit;}
.nav{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg);z-index:100;}
.nav-title{font-size:17px;font-weight:600;color:var(--text);padding:0;}
.nav-title span{color:var(--accent);}
.nav-tabs{display:flex;gap:2px;}
.nav-tab{padding:7px 14px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;color:var(--text2);transition:all .15s;}
.nav-tab.active{background:var(--bg3);color:var(--text);}
.section{padding:20px;max-width:560px;margin:0 auto;}
.section-title{font-size:11px;font-weight:600;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:14px;}
.page-title{font-size:20px;font-weight:600;margin-bottom:4px;}
.page-sub{font-size:13px;color:var(--text2);margin-bottom:20px;}
.select-group{margin-bottom:18px;}
.select-label{font-size:12px;color:var(--text2);margin-bottom:8px;display:block;font-weight:500;}
.select-pills{display:flex;flex-wrap:wrap;gap:6px;}
.pill{padding:7px 14px;border-radius:20px;border:1px solid var(--border2);font-size:13px;color:var(--text2);cursor:pointer;transition:all .15s;}
.pill.active{background:var(--accent);border-color:var(--accent);color:#000;font-weight:600;}
.card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:16px;}
.btn{padding:11px 22px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;cursor:pointer;transition:all .15s;display:inline-block;}
.btn-primary{background:var(--accent);color:#000;}
.btn-primary:hover{background:#f0d060;}
.btn-primary:disabled{background:var(--bg3);color:var(--text3);cursor:default;}
.btn-secondary{background:var(--bg3);border:1px solid var(--border2);color:var(--text);}
.btn-row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:12px;}
.btn-full{width:100%;text-align:center;}
.back-btn{display:flex;align-items:center;gap:6px;color:var(--text2);font-size:13px;margin-bottom:18px;}
.score-bar{background:var(--bg3);border-radius:2px;height:3px;margin-bottom:14px;}
.score-fill{height:100%;background:var(--accent);border-radius:2px;transition:width .3s;}
.swipe-wrap{touch-action:pan-y;user-select:none;-webkit-user-select:none;margin:16px 0;}
.swipe-wrap.enter-left{animation:inLeft .22s ease-out;}
.swipe-wrap.enter-right{animation:inRight .22s ease-out;}
@keyframes inLeft{from{transform:translateX(60px);opacity:0}to{transform:none;opacity:1}}
@keyframes inRight{from{transform:translateX(-60px);opacity:0}to{transform:none;opacity:1}}
.flashcard-scene{width:100%;perspective:1000px;cursor:pointer;height:260px;}
.flashcard-inner{width:100%;height:260px;position:relative;transform-style:preserve-3d;transition:transform .45s;}
.flashcard-inner.flipped{transform:rotateY(180deg);}
.flashcard-face{position:absolute;top:0;left:0;width:100%;height:260px;backface-visibility:hidden;-webkit-backface-visibility:hidden;background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;}
.flashcard-back{transform:rotateY(180deg);}
.flashcard-tap-hint{font-size:11px;color:var(--text3);margin-top:14px;letter-spacing:.05em;}
.flashcard-nav{display:flex;align-items:center;justify-content:center;gap:20px;}
.fc-btn{width:44px;height:44px;border-radius:50%;border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--text2);}
.fc-btn:hover{border-color:var(--accent);color:var(--accent);}
.fc-count{font-size:13px;color:var(--text2);min-width:60px;text-align:center;}
.swipe-hint{text-align:center;font-size:11px;color:var(--text3);margin-bottom:12px;}
.quiz-q{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:14px;text-align:center;}
.quiz-q-label{font-size:12px;color:var(--text3);margin-bottom:8px;}
.quiz-q-main{font-size:24px;font-weight:600;}
.mc-options{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px;}
.mc-option{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:13px;font-size:15px;text-align:center;transition:all .15s;font-family:'Noto Sans JP',sans-serif;}
.mc-option.correct{background:#0d2b18;border-color:var(--green);color:var(--green);}
.mc-option.wrong{background:#2b0d0d;border-color:var(--red);color:var(--red);}
.mc-option:disabled{cursor:default;}
.match-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px;}
.match-col{display:flex;flex-direction:column;gap:6px;}
.match-item{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:11px;font-size:15px;text-align:center;cursor:pointer;transition:all .15s;min-height:56px;display:flex;align-items:center;justify-content:center;font-family:'Noto Sans JP',sans-serif;}
.match-item.selected{border-color:var(--accent);background:rgba(232,200,74,.06);}
.match-item.matched{border-color:var(--green);background:rgba(74,200,122,.06);color:var(--green);cursor:default;}
.match-item.wrong-flash{border-color:var(--red);background:rgba(232,84,84,.06);}
.result-screen{text-align:center;padding:48px 20px;}
.result-score{font-size:64px;font-weight:700;color:var(--accent);margin-bottom:6px;line-height:1;}
.result-label{font-size:15px;color:var(--text2);margin-bottom:28px;}
.group-item{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:12px 14px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;margin-bottom:6px;}
.group-item.selected{border-color:var(--accent);background:rgba(232,200,74,.06);}
.group-item-name{font-size:14px;font-weight:500;}
.group-item-count{font-size:12px;color:var(--text3);}
.note{font-size:12px;color:var(--text3);margin-top:6px;}
</style>
</head>
<body>
<div id="app"></div>
<script>
// ============================================================
// VOCABULARY — "Class 10-27-26"  [kana, kanji, english]
// ============================================================
var LIST_NAME = "Class 10-27-26";
var RAW = [
["りょこう","旅行","travel"],["おんせん","温泉","hot spring"],["りょかん","旅館","traditional Japanese inn"],["たべもの","食べ物","food"],
["ラーメン","","ramen"],["とんかつ","","breaded pork cutlet"],["すし","寿司","sushi"],["うんどう","運動","exercise"],
["ジム","","gym"],["ジョギング","","jogging"],["じてんしゃ","自転車","bicycle"],["サイクリング","","cycling"],
["スノーボード","","snowboarding"],["ハイキング","","hiking"],["どくしょ","読書","reading"],["レジャー","","leisure"],
["えいが","映画","movie"],["ゲーム","","game"],["ドラマ","","drama"],["ビデオ","","video"],
["かぞく","家族","family"],["はは","母","mother (my mother)"],["ちち","父","father (my father)"],
["おかあさん","お母さん","mother"],["おとうさん","お父さん","father"],["あね","姉","older sister (my sister)"],
["いもうと","妹","younger sister"],["おとうと","弟","younger brother"],["あに","兄","older brother (my brother)"],
["つま","妻","wife"],["しゅじん","主人","husband"],["むすこ","息子","son"],["むすめ","娘","daughter"],
["すき","好き","like; favorite"],["すきじゃない","好きじゃない","do not like"],["すきじゃありません","好きじゃありません","do not like (polite)"],
["とても","","very"],["とくに","特に","especially"],["じょうず","上手","skilled; good at"],
["あります","","there is; have (inanimate)"],["ありません","","there is not; do not have (inanimate)"],
["あまり","","not very; not much (with negative)"],["ぜんぜん","全然","not at all (with negative)"],
["ぜんぶ","全部","all; everything"],["なか","中","inside"],["とか","","and things like; among other things"],
["わたし","私","I; me"],["へん","変","strange; unusual"],["あい","愛","love"],["マップ","","map"],
["にほんご","日本語","Japanese language"],["えいご","英語","English language"],["カタカナ","","katakana"],
["かんじ","漢字","kanji; Chinese characters"],["なに","何","what"],["なん","何","what (alternate reading)"],
["やさい","野菜","vegetables"],["オクラ","","okra"],["ほうれんそう","","spinach"],["にがうり","苦瓜","bitter melon"],
["すいえい","水泳","swimming"],["かいすいよく","海水浴","swimming in the sea"],["うみ","海","sea; ocean"],["みず","水","water"],
["しぜん","自然","nature"],["もり","森","forest"],["くだもの","果物","fruit"],["もも","桃","peach"],
["さくらんぼ","","cherry"],["みかん","","mandarin orange"],["オレンジ","","orange"],
["りょうり","料理","cooking; cuisine"],["にほんりょうり","日本料理","Japanese cuisine"],
["ゴーヤー","","bitter melon (Okinawan term)"],["チャンプルー","","Okinawan stir-fry"],["ベイキング","","baking"],
["キャンプ","","camping"],["さんぽ","散歩","walk; stroll"],["アウトドア","","outdoors"],["ガーデニング","","gardening"],
["よせうえ","寄せ植え","mixed flower pot"],["しょうせつ","小説","novel"],["エッセイ","","essay"],["マンガ","","manga; comic"],
["スポーツ","","sports"],["バレーボール","","volleyball"],["ボート","","boat"],["ボーティング","","boating"],
["やま","山","mountain"],["だいせん","大山","Mount Daisen"],["ふじさん","富士山","Mount Fuji"],
["エスエフ","","science fiction (SF)"],["アクション","","action"],["うち","","home; house"],["おかし","お菓子","sweets; snacks"],
["きのう","昨日","yesterday"],["いけだ","池田","Ikeda (surname)"],["めぐみ","恵","Megumi (given name)"],
["しをん","","Shion (given name)"],["みうら","三浦","Miura (surname)"],["よしもと","","Yoshimoto (surname)"],
["ばなな","","Banana (given/pen name)"],["きんようび","金曜日","Friday"],["にっき","日記","diary"]
];
var VOCAB = RAW.map(function(a){return {r:a[0],k:a[1],e:a[2],d:a[1]||a[0]};});

// ============================================================
// HELPERS / STATE
// ============================================================
function loadWL(){try{return JSON.parse(localStorage.getItem('jpWorkingList')||'[]');}catch(e){return[];}}
function saveWL(l){try{localStorage.setItem('jpWorkingList',JSON.stringify(l));}catch(e){}}
function shuffle(a){var b=a.slice();for(var i=b.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=b[i];b[i]=b[j];b[j]=t;}return b;}
function same(a,b){return a.r===b.r&&a.k===b.k&&a.e===b.e;}

var state={
  screen:'home', source:'class',
  fcFront:'kanji', fcCards:[], fcIdx:0, fcFlipped:false, fcDir:'',
  workingList:loadWL(),
  qzType:'mc', qzFront:'kanji',
  qzStarted:false, qzDone:false, qzQuestions:[], qzIdx:0, qzScore:0, qzTotal:0,
  qzAnswered:false, qzSelected:null,
  matchPairs:[], matchRight:[], matchSelL:null, matchSelR:null, matchMatched:[], matchPool:[]
};
function setState(u){
  Object.assign(state,u);
  if(u.workingList!==undefined) saveWL(state.workingList);
  render();
}
function getWords(){return state.source==='working'?state.workingList:VOCAB;}

// ============================================================
// RENDER
// ============================================================
function render(){
  document.getElementById('app').innerHTML=buildNav()+'<div>'+buildScreen()+'</div>';
}
function buildNav(){
  var home='<button class="nav-title" onclick="goHome()">日本語 <span>Study</span></button>';
  if(state.screen==='home') return '<div class="nav">'+home+'<div style="font-size:12px;color:var(--text3);">'+LIST_NAME+'</div></div>';
  return '<div class="nav">'+home+'<div class="nav-tabs">'+
    '<button class="nav-tab '+(state.screen==='flashcards'?'active':'')+'" onclick="goTo(\'flashcards\')">Cards</button>'+
    '<button class="nav-tab '+(state.screen==='quiz'?'active':'')+'" onclick="goTo(\'quiz\')">Quiz</button></div></div>';
}
function buildScreen(){
  if(state.screen==='flashcards') return state.fcCards.length?buildFCStudy():buildFCSetup();
  if(state.screen==='quiz'){
    if(!state.qzStarted) return buildQZSetup();
    if(state.qzDone) return buildQZResult();
    return state.qzType==='mc'?buildMC():buildMatch();
  }
  return buildHome();
}

function buildHome(){
  return '<div class="section">'+
    '<div class="page-title">おはようございます</div>'+
    '<div class="page-sub">What would you like to study today?</div>'+
    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:28px;">'+
      '<button class="card" style="text-align:left;" onclick="goTo(\'flashcards\')"><div style="font-size:14px;font-weight:600;margin-bottom:4px;">Flashcards</div><div style="font-size:12px;color:var(--text2);">Swipe through words</div></button>'+
      '<button class="card" style="text-align:left;" onclick="goTo(\'quiz\')"><div style="font-size:14px;font-weight:600;margin-bottom:4px;">Quiz</div><div style="font-size:12px;color:var(--text2);">Multiple choice &amp; matching</div></button>'+
    '</div>'+
    '<div class="section-title">Vocabulary list</div>'+
    '<div class="card"><div style="font-size:15px;font-weight:600;">'+LIST_NAME+'</div><div style="font-size:12px;color:var(--text2);margin-top:2px;">'+VOCAB.length+' words</div></div>'+
  '</div>';
}

// ============================================================
// SETUP (shared)
// ============================================================
function frontPills(key,cur){
  return ['kanji','kana','english'].map(function(f){
    return '<div class="pill '+(cur===f?'active':'')+'" onclick="setState({'+key+':\''+f+'\'})">'+f.charAt(0).toUpperCase()+f.slice(1)+'</div>';
  }).join('');
}
function sourceBlock(){
  var wl=state.workingList.length;
  return '<div class="select-group"><span class="select-label">Word list</span>'+
    '<div class="group-item '+(state.source==='class'?'selected':'')+'" onclick="setState({source:\'class\'})"><span class="group-item-name">'+LIST_NAME+'</span><span class="group-item-count">'+VOCAB.length+' words'+(state.source==='class'?' ✓':'')+'</span></div>'+
    '<div class="group-item '+(state.source==='working'?'selected':'')+'" onclick="setState({source:\'working\'})"><span class="group-item-name">My Working List</span><span class="group-item-count">'+wl+' word'+(wl===1?'':'s')+(state.source==='working'?' ✓':'')+'</span></div>'+
    (state.source==='working'&&wl===0?'<div class="note">No words yet. Add words from the back of any flashcard.</div>':'')+
  '</div>';
}

function buildFCSetup(){
  var n=getWords().length;
  return '<div class="section"><div class="page-title">Flashcards</div><div class="page-sub">Choose a list and what to show first</div>'+
    sourceBlock()+
    '<div class="select-group"><span class="select-label">Show on front</span><div class="select-pills">'+frontPills('fcFront',state.fcFront)+'</div></div>'+
    '<button class="btn btn-primary btn-full" onclick="startFC()" '+(n===0?'disabled':'')+'>Start flashcards</button></div>';
}

function buildQZSetup(){
  var words=quizPool();
  var min=state.qzType==='mc'?2:2;
  return '<div class="section"><div class="page-title">Quiz</div><div class="page-sub">Test yourself on '+LIST_NAME+'</div>'+
    sourceBlock()+
    '<div class="select-group"><span class="select-label">Quiz focus</span><div class="select-pills">'+frontPills('qzFront',state.qzFront)+'</div>'+
      '<div class="note">'+(state.qzFront==='kanji'?'Kanji → reading (words with kanji only)':state.qzFront==='kana'?'Kana → meaning':'Meaning → kanji (or kana if no kanji)')+' · '+words.length+' words available</div></div>'+
    '<div class="select-group"><span class="select-label">Format</span><div class="select-pills">'+
      '<div class="pill '+(state.qzType==='mc'?'active':'')+'" onclick="setState({qzType:\'mc\'})">Multiple choice</div>'+
      '<div class="pill '+(state.qzType==='match'?'active':'')+'" onclick="setState({qzType:\'match\'})">Matching pairs</div></div></div>'+
    '<button class="btn btn-primary btn-full" onclick="startQuiz()" '+(words.length<min?'disabled':'')+'>Start quiz</button></div>';
}

// ============================================================
// FLASHCARDS + SWIPE
// ============================================================
function buildFCStudy(){
  var cards=state.fcCards, idx=state.fcIdx, c=cards[idx];
  var front=state.fcFront==='kanji'?c.d:state.fcFront==='kana'?c.r:c.e;
  var inW=state.workingList.some(function(w){return same(w,c);});
  var enter=state.fcDir?(' enter-'+state.fcDir):'';
  return '<div class="section">'+
    '<button class="back-btn" onclick="setState({fcCards:[],fcIdx:0,fcFlipped:false,fcDir:\'\'})">← Settings</button>'+
    '<div style="display:flex;justify-content:space-between;margin-bottom:6px;"><span style="font-size:12px;color:var(--text2);">'+(state.source==='working'?'My Working List':LIST_NAME)+'</span><span style="font-size:12px;color:var(--text2);">'+(idx+1)+' / '+cards.length+'</span></div>'+
    '<div class="score-bar"><div class="score-fill" style="width:'+Math.round((idx+1)/cards.length*100)+'%"></div></div>'+
    '<div class="swipe-wrap'+enter+'" id="swipeWrap"><div class="flashcard-scene" id="fcScene"><div class="flashcard-inner'+(state.fcFlipped?' flipped':'')+'" id="fcInner">'+
      '<div class="flashcard-face"><div class="jp" style="font-size:'+(state.fcFront==='english'?'26':'34')+'px;font-weight:700;">'+front+'</div><div class="flashcard-tap-hint">tap to flip · swipe to move</div></div>'+
      '<div class="flashcard-face flashcard-back">'+
        '<div style="margin-bottom:10px;"><div style="font-size:11px;color:var(--text3);margin-bottom:2px;">Kanji</div><div class="jp" style="font-size:26px;font-weight:700;">'+c.d+'</div></div>'+
        '<div style="margin-bottom:10px;"><div style="font-size:11px;color:var(--text3);margin-bottom:2px;">Reading</div><div class="jp" style="font-size:18px;">'+c.r+'</div></div>'+
        '<div style="margin-bottom:12px;"><div style="font-size:11px;color:var(--text3);margin-bottom:2px;">Meaning</div><div style="font-size:15px;color:var(--accent);">'+c.e+'</div></div>'+
        '<button onclick="toggleWorkingWord(event)" style="padding:4px 12px;border-radius:20px;border:1px solid var(--border3);color:var(--text3);font-size:11px;">'+(inW?'Remove from working list':'Add to working list')+'</button>'+
      '</div></div></div></div>'+
    '<div class="swipe-hint">← swipe left for next · swipe right for previous →</div>'+
    '<div class="flashcard-nav"><button class="fc-btn" onclick="fcPrev()">←</button><span class="fc-count">'+(idx+1)+' of '+cards.length+'</span><button class="fc-btn" onclick="fcNext()">→</button></div>'+
    '<div style="text-align:center;margin-top:14px;"><button class="btn btn-secondary" style="font-size:13px;" onclick="setState({fcCards:shuffle(state.fcCards),fcIdx:0,fcFlipped:false,fcDir:\'\'})">Shuffle</button></div>'+
  '</div>';
}

function startFC(){setState({fcCards:shuffle(getWords()),fcIdx:0,fcFlipped:false,fcDir:''});}
function fcGo(delta){
  var n=state.fcIdx+delta;
  if(n<0||n>=state.fcCards.length) return false;
  setState({fcIdx:n,fcFlipped:false,fcDir:delta>0?'left':'right'});
  return true;
}
window.fcNext=function(){fcGo(1);};
window.fcPrev=function(){fcGo(-1);};
window.toggleWorkingWord=function(e){
  e.stopPropagation();
  var c=state.fcCards[state.fcIdx], wl=state.workingList;
  var has=wl.some(function(w){return same(w,c);});
  setState({workingList:has?wl.filter(function(w){return !same(w,c);}):wl.concat([c])});
  // keep card showing the back after re-render
  var inner=document.getElementById('fcInner'); if(inner){inner.style.transition='none';inner.classList.add('flipped');}
  state.fcFlipped=true;
};

// Swipe handling (touch + mouse) via pointer events on the card
(function(){
  var sx=0,sy=0,dx=0,dragging=false,moved=false,wrap=null;
  var app=document.getElementById('app');
  app.addEventListener('pointerdown',function(e){
    var scene=e.target.closest&&e.target.closest('#fcScene'); if(!scene||e.target.closest('button')) return;
    wrap=document.getElementById('swipeWrap'); dragging=true; moved=false; sx=e.clientX; sy=e.clientY; dx=0;
    wrap.style.transition='none';
  });
  window.addEventListener('pointermove',function(e){
    if(!dragging) return;
    dx=e.clientX-sx; var dy=e.clientY-sy;
    if(Math.abs(dx)>10&&Math.abs(dx)>Math.abs(dy)) moved=true;
    if(moved){wrap.style.transform='translateX('+dx+'px) rotate('+(dx/25)+'deg)';wrap.style.opacity=String(Math.max(.4,1-Math.abs(dx)/500));}
  });
  function end(){
    if(!dragging) return; dragging=false;
    var w=wrap; wrap=null; if(!w) return;
    if(!moved){ // tap → flip
      w.style.transform='';w.style.opacity='';
      var inner=document.getElementById('fcInner');
      if(inner){var f=!state.fcFlipped; state.fcFlipped=f; inner.style.transition=''; inner.classList.toggle('flipped',f);}
      return;
    }
    var threshold=70, goNext=dx<-threshold, goPrev=dx>threshold;
    var canNext=state.fcIdx<state.fcCards.length-1, canPrev=state.fcIdx>0;
    if((goNext&&canNext)||(goPrev&&canPrev)){
      w.style.transition='transform .18s ease-in,opacity .18s';
      w.style.transform='translateX('+(goNext?-120:120)+'%) rotate('+(goNext?-12:12)+'deg)';w.style.opacity='0';
      setTimeout(function(){fcGo(goNext?1:-1);},180);
    } else { // snap back
      w.style.transition='transform .2s,opacity .2s';w.style.transform='';w.style.opacity='';
    }
  }
  window.addEventListener('pointerup',end);
  window.addEventListener('pointercancel',end);
  document.addEventListener('keydown',function(e){
    if(state.screen!=='flashcards'||!state.fcCards.length) return;
    if(e.key==='ArrowRight') fcGo(1);
    else if(e.key==='ArrowLeft') fcGo(-1);
    else if(e.key===' '){e.preventDefault();var inner=document.getElementById('fcInner');var f=!state.fcFlipped;state.fcFlipped=f;if(inner)inner.classList.toggle('flipped',f);}
  });
})();

// ============================================================
// QUIZ
// ============================================================
function uniqueBy(arr,fn){var seen={},out=[];arr.forEach(function(w){var k=fn(w);if(!seen[k]){seen[k]=1;out.push(w);}});return out;}
function quizPool(){
  var words=getWords(), f=state.qzFront;
  if(f==='kanji'){
    // only words with kanji; drop ones whose kanji or reading is shared with another word (ambiguous)
    var wk=words.filter(function(w){return w.k;});
    var kc={},rc={};wk.forEach(function(w){kc[w.k]=(kc[w.k]||0)+1;rc[w.r]=(rc[w.r]||0)+1;});
    return wk.filter(function(w){return kc[w.k]===1&&rc[w.r]===1;});
  }
  if(f==='kana') return uniqueBy(words,function(w){return w.r;}).filter(function(w){return words.filter(function(x){return x.r===w.r;}).length===1;});
  return uniqueBy(words,function(w){return w.e;});
}
function qParts(w){
  var f=state.qzFront;
  if(f==='kanji') return {q:w.k,a:w.r,hint:'What is the reading?',pool:'r'};
  if(f==='kana') return {q:w.r,a:w.e,hint:'What does this mean?',pool:'e'};
  return {q:w.e,a:w.d,hint:'Which word is this?',pool:'d'};
}
function startQuiz(){
  var words=shuffle(quizPool());
  if(state.qzType==='mc'){
    var qs=words.slice(0,10).map(function(w){
      var p=qParts(w);
      var others=shuffle(words.filter(function(x){return x[p.pool]!==p.a;}).map(function(x){return x[p.pool];}));
      others=uniqueBy(others.map(function(v){return {v:v};}),function(o){return o.v;}).map(function(o){return o.v;});
      var opts=shuffle([p.a].concat(others.slice(0,3)));
      return {q:p.q,hint:p.hint,options:opts,ans:opts.indexOf(p.a)};
    });
    setState({qzQuestions:qs,qzIdx:0,qzScore:0,qzTotal:qs.length,qzDone:false,qzAnswered:false,qzSelected:null,qzStarted:true});
  } else {
    state.matchPool=words;
    state.qzScore=0; state.qzTotal=0;
    setupMatch(words);
  }
}
function setupMatch(words){
  var pairs=shuffle(words).slice(0,6).map(function(w){var p=qParts(w);return {q:p.q,ans:p.a};});
  var right=shuffle(pairs.map(function(p,i){return {ans:p.ans,origIdx:i};}));
  setState({matchPairs:pairs,matchRight:right,matchMatched:[],matchSelL:null,matchSelR:null,qzTotal:state.qzTotal+pairs.length,qzDone:false,qzStarted:true});
}

function buildMC(){
  var q=state.qzQuestions[state.qzIdx]; if(!q) return '';
  var total=state.qzQuestions.length;
  return '<div class="section">'+
    '<div style="display:flex;justify-content:space-between;margin-bottom:6px;"><span style="font-size:12px;color:var(--text2);">Question '+(state.qzIdx+1)+' of '+total+'</span><span style="font-size:12px;color:var(--accent);">Score: '+state.qzScore+'</span></div>'+
    '<div class="score-bar"><div class="score-fill" style="width:'+Math.round(state.qzIdx/total*100)+'%"></div></div>'+
    '<div class="quiz-q"><div class="quiz-q-label">'+q.hint+'</div><div class="quiz-q-main jp">'+q.q+'</div></div>'+
    '<div class="mc-options">'+q.options.map(function(opt,i){
      var cls='mc-option';
      if(state.qzAnswered){if(i===q.ans)cls+=' correct';else if(i===state.qzSelected)cls+=' wrong';}
      return '<button class="'+cls+'" '+(state.qzAnswered?'disabled':'')+' onclick="answerMC('+i+')">'+opt+'</button>';
    }).join('')+'</div>'+
    (state.qzAnswered?'<div class="btn-row"><button class="btn btn-primary" onclick="nextQ()">'+(state.qzIdx+1>=total?'See results':'Next →')+'</button></div>':'')+
  '</div>';
}
window.answerMC=function(i){
  var q=state.qzQuestions[state.qzIdx];
  setState({qzAnswered:true,qzSelected:i,qzScore:i===q.ans?state.qzScore+1:state.qzScore});
};
window.nextQ=function(){
  var n=state.qzIdx+1;
  if(n>=state.qzQuestions.length) setState({qzDone:true,qzAnswered:false});
  else setState({qzIdx:n,qzAnswered:false,qzSelected:null});
};

function buildMatch(){
  var L=state.matchPairs,R=state.matchRight,M=state.matchMatched;
  return '<div class="section">'+
    '<div style="display:flex;justify-content:space-between;margin-bottom:10px;"><span style="font-size:12px;color:var(--text2);">Matching pairs</span><span style="font-size:12px;color:var(--accent);">Score: '+state.qzScore+'</span></div>'+
    '<div class="quiz-q" style="margin-bottom:12px;"><div class="quiz-q-label">Match each item to its pair</div></div>'+
    '<div class="match-grid"><div class="match-col">'+L.map(function(p,i){
      return '<button class="match-item '+(M.indexOf(i)>=0?'matched':'')+' '+(state.matchSelL===i?'selected':'')+'" id="ml-'+i+'" '+(M.indexOf(i)>=0?'disabled':'')+' onclick="selMatchL('+i+')">'+p.q+'</button>';
    }).join('')+'</div><div class="match-col">'+R.map(function(r,i){
      var m=M.indexOf(r.origIdx)>=0;
      return '<button class="match-item '+(m?'matched':'')+' '+(state.matchSelR===i?'selected':'')+'" id="mr-'+i+'" '+(m?'disabled':'')+' onclick="selMatchR('+i+')">'+r.ans+'</button>';
    }).join('')+'</div></div>'+
    (M.length===L.length?'<div class="btn-row"><button class="btn btn-primary" onclick="nextMatchRound()">Next round</button><button class="btn btn-secondary" onclick="setState({qzDone:true})">Finish</button></div>':'')+
  '</div>';
}
window.selMatchL=function(i){setState({matchSelL:i});checkMatch();};
window.selMatchR=function(i){setState({matchSelR:i});checkMatch();};
function checkMatch(){
  var l=state.matchSelL,r=state.matchSelR;
  if(l===null||r===null) return;
  if(state.matchRight[r].origIdx===l){
    setState({matchMatched:state.matchMatched.concat([l]),matchSelL:null,matchSelR:null,qzScore:state.qzScore+1});
  } else {
    setState({matchSelL:null,matchSelR:null});
    var ml=document.getElementById('ml-'+l),mr=document.getElementById('mr-'+r);
    [ml,mr].forEach(function(el){if(el){el.classList.add('wrong-flash');setTimeout(function(){el.classList.remove('wrong-flash');},500);}});
  }
}
window.nextMatchRound=function(){setupMatch(state.matchPool);};

function buildQZResult(){
  var s=state.qzScore,t=state.qzTotal||s,pct=t>0?Math.round(s/t*100):100;
  return '<div class="result-screen"><div class="result-score">'+s+'/'+t+'</div>'+
    '<div class="result-label">'+(pct>=80?'Excellent work!':pct>=50?'Good effort.':'Keep studying.')+'</div>'+
    '<div class="btn-row"><button class="btn btn-primary" onclick="startQuiz()">Try again</button>'+
    '<button class="btn btn-secondary" onclick="setState({qzStarted:false,qzDone:false,qzScore:0,qzIdx:0,qzQuestions:[]})">New settings</button></div></div>';
}

// ============================================================
// NAV
// ============================================================
window.goHome=function(){setState({screen:'home',fcCards:[],fcIdx:0,fcFlipped:false,qzStarted:false,qzDone:false});};
window.goTo=function(s){setState({screen:s,fcCards:[],fcIdx:0,fcFlipped:false,qzStarted:false,qzDone:false});};

render();
</script>
